+ result["trial_limits"]=json::object{{"cpu_threads",trial_budget.cpu_threads},{"ram_mb",trial_budget.ram_mb},{"scratch_mb",trial_budget.scratch_mb},{"max_jobs",trial_max_jobs},{"automatic_requested",automatic}};
